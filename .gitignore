# dependencies
node_modules/
.pnp
.pnp.js

# next.js
/.next/
/out/
next-env.d.ts

# Build output.
#
# Anchored, and so is everything below that names a directory. An unanchored
# pattern matches at *every* depth: `build/` silently swallowed
# src/app/admin/(dashboard)/build/, and `storage/` did the same to
# src/server/storage/ before it. Both looked fine locally — the files were on
# disk — and both produced a repository that could not build.
/build/
/dist/

# generated
/src/generated/
*.tsbuildinfo

# testing
/coverage/
/test-results/
/playwright-report/
/blob-report/
/.playwright/

# local storage provider root
/storage/
!/storage/.gitkeep

# environment — never commit real secrets
.env
.env.*
!.env.example

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/

# Local agent scratch space
.scratch/
