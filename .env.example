# ---------------------------------------------------------------------------
# Digital Profile OS — environment configuration
# Copy to `.env` and fill in. NEVER commit a real .env file.
# All variables are validated at startup by src/lib/env.ts; the app refuses to
# boot in production when a required value is missing or malformed.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://dpos:dpos@localhost:5432/digital_profile_os?schema=public
# Only used by `prisma migrate dev` to diff migrations. Optional.
SHADOW_DATABASE_URL=postgresql://dpos:dpos@localhost:5432/digital_profile_os_shadow?schema=public

# --- URLs ------------------------------------------------------------------
# Origin the application is served from (admin + api).
APP_URL=http://localhost:3000
# Origin embedded in permanent QR codes. Changing this after QR codes are
# printed breaks them — treat it as immutable per deployment.
PUBLIC_URL=http://localhost:3000

# --- Storage ---------------------------------------------------------------
# local | r2
STORAGE_PROVIDER=local
# Filesystem root for the local provider, relative to the project root.
STORAGE_LOCAL_ROOT=storage
# Public URL prefix the local provider serves objects from.
STORAGE_LOCAL_PUBLIC_PREFIX=/uploads

# Required only when STORAGE_PROVIDER=r2. STORAGE_ENDPOINT is the account-level
# S3 endpoint (do not append the bucket); STORAGE_PUBLIC_BASE_URL is the public
# R2 custom domain/base that serves visitor-facing media.
# STORAGE_BUCKET=menus
# STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_PUBLIC_BASE_URL=https://media.example.com

# --- Auth / sessions -------------------------------------------------------
# Required in production. Generate with: openssl rand -base64 32
AUTH_SECRET=dev-only-insecure-secret-change-me-0000000000

# --- Optional services -----------------------------------------------------
# Redis is optional and never required for local development.
# REDIS_URL=redis://localhost:6379

# Salt used to derive non-reversible visitor hashes for analytics. Required in
# production once analytics ship (Phase 7).
# ANALYTICS_SALT=

# First staff account, created on release when no account with this email exists.
# The password must be at least 12 characters. Safe to remove once the account
# exists — the bootstrap never resets an existing password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
