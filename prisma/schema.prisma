// Digital Profile OS — core schema foundation (Phase 0).
//
// Scope note: this is deliberately the minimum relational core required by the
// Phase 0 acceptance criteria (tenancy, public identifiers, menu publication,
// bilingual content, brand tokens). Branches, categories, items, offers, files,
// QR records, analytics and import batches arrive in later phases — see
// docs/GOALS.md §6.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Platform-level role. The platform is a managed service: staff operate it,
/// clients do not receive accounts in v1 (GOALS I10, master spec §17).
enum PlatformRole {
  SUPER_ADMIN
  STAFF
}

/// A user's role *within* one business. Tenant authorization is derived from
/// membership rows, never from a client-supplied business id (GOALS I8).
enum BusinessRole {
  OWNER
  MANAGER
  EDITOR
  VIEWER
}

enum BusinessStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum BusinessType {
  RESTAURANT
  CAFE
  BAKERY
  DESSERT
  SALON
  BEAUTY_CENTER
  SPA
  BARBER
  GYM
  HOTEL
  RETAIL
  OTHER
}

/// Supported content and interface locales. Arabic is the primary authored
/// language; English is a first-class peer, never machine-filled (GOALS I3).
enum Locale {
  ar
  en
}

enum MenuStatus {
  DRAFT
  ACTIVE
  INACTIVE
  ARCHIVED
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String?
  role         PlatformRole @default(STAFF)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  lastLoginAt DateTime?

  memberships     BusinessMembership[]
  publishedMenues MenuVersion[]        @relation("MenuVersionPublisher")
  auditLogs       AuditLog[]
  uploadedFiles   PublicFileVersion[]
  importBatches   ImportBatch[]
  priceChanges    PriceHistory[]
  previewLinks       PreviewLink[]   @relation("PreviewLinkCreator")
  completedRequests  ChangeRequest[] @relation("ChangeRequestCompleter")

  @@index([role])
  @@map("users")
}

/// The tenant. Every tenant-scoped row reaches this model through a
/// `businessId` foreign key, which is what server-side isolation filters on.
model Business {
  /// Internal identifier. Never appears in a public URL.
  id String @id @default(cuid())

  /// Opaque, stable, public-facing identifier used by the permanent QR:
  /// `/m/{publicId}` (e.g. 7XK92A). Immutable for the life of the business —
  /// changing it would invalidate printed QR codes (GOALS I1, I2).
  publicId String @unique

  /// Human-readable admin-facing handle. Not the public URL key.
  slug String @unique

  type          BusinessType   @default(OTHER)
  status        BusinessStatus @default(DRAFT)
  /// Locale a visitor gets when they express no preference.
  defaultLocale Locale         @default(ar)

  nameAr        String
  nameEn        String?
  descriptionAr String?
  descriptionEn String?

  /// Structure. Validated against the in-code template registry
  /// (src/templates/registry.ts) — templates are code, not database rows.
  templateKey String @default("editorial")
  /// Layout variant within the template family.
  variantKey  String @default("a")

  /// --- Contact (master spec §20, §44). Empty fields hide their action. ---
  phone         String?
  whatsapp      String?
  email         String?
  website       String?
  instagram     String?
  tiktok        String?
  facebook      String?
  linkedin      String?
  youtube       String?
  googleMapsUrl String?
  addressAr     String?
  addressEn     String?
  workingHours  Json?

  /// Default currency for item prices (§36).
  currency String @default("SAR")

  /// --- SEO (§116). Profiles are not indexable unless explicitly enabled. ---
  indexProfile      Boolean @default(false)
  metaTitleAr       String?
  metaTitleEn       String?
  metaDescriptionAr String?
  metaDescriptionEn String?
  ogMediaId         String?

  /// --- Service package (§156, §157) ---
  servicePackage     ServicePackage @default(STANDARD)
  packageStartsAt    DateTime?
  packageEndsAt      DateTime?
  /// Optional "Digital Menu by ..." footer (§147).
  showPlatformFooter Boolean        @default(false)

  logoMediaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships     BusinessMembership[]
  brandTheme      BrandTheme?
  menus           Menu[]
  branches        Branch[]
  categories      MenuCategory[]
  items           MenuItem[]
  media           Media[]
  qrCodes         QrCode[]
  auditLogs       AuditLog[]
  publicFiles     PublicFile[]
  offers          Offer[]
  importBatches   ImportBatch[]
  priceHistory    PriceHistory[]
  analyticsEvents AnalyticsEvent[]
  modifierGroups  ModifierGroup[]
  menuDesigns     MenuDesign[]
  brandPresets    BrandPreset[]
  previewLinks    PreviewLink[]
  changeRequests  ChangeRequest[]
  logo            Media?               @relation("BusinessLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  ogImage         Media?               @relation("BusinessOgImage", fields: [ogMediaId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([createdAt])
  @@map("businesses")
}

/// Join table carrying the tenant grant. Authorization asks: does this user
/// hold a membership for this business, and does that role permit the action?
model BusinessMembership {
  id         String       @id @default(cuid())
  userId     String
  businessId String
  role       BusinessRole @default(VIEWER)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@unique([userId, businessId])
  @@index([businessId])
  @@map("business_memberships")
}

/// Visual identity — the *theme* half of template/theme separation (GOALS I6).
/// These values are emitted as CSS custom properties at render time; no
/// component hard-codes a business colour.
model BrandTheme {
  id         String @id @default(cuid())
  businessId String @unique

  colorPrimary    String @default("#1F2421")
  colorSecondary  String @default("#49A078")
  colorAccent     String @default("#C9A227")
  colorBackground String @default("#FBF9F5")
  colorSurface    String @default("#FFFFFF")
  colorText       String @default("#16181A")
  colorMuted      String @default("#6B7280")
  colorBorder     String @default("#E5E1D8")

  /// Font family stack keys resolved by the typography layer.
  fontHeading String @default("system-serif")
  fontBody    String @default("system-sans")

  radiusScale String  @default("md")
  logoMediaId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("brand_themes")
}

/// A menu (or service catalogue). Categories and items land in Phase 1; the
/// publication mechanism is established here because the permanent-QR
/// invariant depends on it: the QR resolves to a business, the business
/// resolves to a *currently published* menu version.
model Menu {
  id         String     @id @default(cuid())
  businessId String
  /// Tenant-scoped key, e.g. "main", "breakfast", "drinks".
  key        String
  status     MenuStatus @default(DRAFT)
  titleAr    String
  titleEn    String?
  sortOrder  Int        @default(0)

  currentVersionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  categories     MenuCategory[]
  versions       MenuVersion[]  @relation("MenuVersions")
  design         MenuDesign?
  currentVersion MenuVersion?   @relation("MenuCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([businessId, key])
  @@index([businessId, status])
  @@map("menus")
}

/// An immutable publication record. Content changes create a new version and
/// repoint `Menu.currentVersion`; the public URL and QR never change (GOALS I2).
model MenuVersion {
  id      String @id @default(cuid())
  menuId  String
  /// Monotonic per menu.
  version Int

  publishedAt   DateTime?
  publishedById String?
  notes         String?

  /// The menu exactly as it stood when this version was published: categories,
  /// items, prices, availability, image references and the studio design row.
  /// A version without one predates snapshotting and cannot be restored — the
  /// history screen says so rather than pretending (master spec §84, §85).
  snapshot Json?

  /// Counts of what changed against the previous version, computed once at
  /// publish time so the history list never has to diff on render.
  summary Json?

  /// Set when this version was created by restoring an earlier one, naming the
  /// version restored. A rollback is itself a publish — it moves the menu
  /// forward to old content rather than deleting history (§85).
  restoredFromVersion Int?

  createdAt DateTime @default(now())

  menu        Menu  @relation("MenuVersions", fields: [menuId], references: [id], onDelete: Cascade)
  currentOf   Menu? @relation("MenuCurrentVersion")
  publishedBy User? @relation("MenuVersionPublisher", fields: [publishedById], references: [id], onDelete: SetNull)

  @@unique([menuId, version])
  @@index([menuId, publishedAt])
  @@map("menu_versions")
}

// ---------------------------------------------------------------------------
// PHASE 1 — content domain: branches, categories, items, media.
// ---------------------------------------------------------------------------

enum MediaKind {
  LOGO
  ITEM_IMAGE
  CATEGORY_IMAGE
  OFFER_IMAGE
  GALLERY
  DOCUMENT
  OG_IMAGE
}

/// Item availability (master spec §83). `HIDDEN` removes the item from the
/// public profile entirely; `UNAVAILABLE` may be shown as "currently
/// unavailable" depending on business configuration.
enum ItemAvailability {
  AVAILABLE
  UNAVAILABLE
  SEASONAL
  HIDDEN
}

/// Service package (master spec §156). Gates optional capabilities such as
/// analytics and platform-branding removal.
enum ServicePackage {
  BASIC
  STANDARD
  PREMIUM
  ENTERPRISE
}

/// An uploaded asset. Rows are tenant-owned and reference a provider-agnostic
/// storage key — never a vendor URL (master spec §56, §87).
model Media {
  id         String    @id @default(cuid())
  businessId String
  kind       MediaKind @default(ITEM_IMAGE)

  /// Key understood by the active StorageProvider.
  storageKey  String @unique
  contentType String
  sizeBytes   Int
  width       Int?
  height      Int?

  /// Alt text is authored per language and never machine-generated.
  altAr String?
  altEn String?

  /// Original upload filename, used to match Excel image-ZIP rows (§71).
  originalName String?
  checksum     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business        Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logoOf          Business[]      @relation("BusinessLogo")
  brandPresetLogo BrandPreset[]   @relation("BrandPresetLogo")
  ogImageOf       Business[]      @relation("BusinessOgImage")
  categoryImageOf MenuCategory[]
  offerImageOf    Offer[]
  itemImageOf     MenuItem[]
  itemGallery     MenuItemImage[]

  @@index([businessId, kind])
  @@map("media")
}

/// A physical location. Branches may override price and availability without
/// duplicating the menu (master spec §84, §86).
model Branch {
  id         String @id @default(cuid())
  businessId String
  /// Stable, tenant-scoped path segment: `/m/{publicId}/b/{key}` (§85).
  key        String

  nameAr    String
  nameEn    String?
  addressAr String?
  addressEn String?

  phone         String?
  whatsapp      String?
  googleMapsUrl String?
  /// Structured per-day opening hours; see src/server/business/hours.ts.
  workingHours  Json?

  latitude  Decimal? @db.Decimal(9, 6)
  longitude Decimal? @db.Decimal(9, 6)

  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business  Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  overrides BranchItemOverride[]
  qrCodes   QrCode[]

  @@unique([businessId, key])
  @@index([businessId, isActive])
  @@map("branches")
}

model MenuCategory {
  id         String @id @default(cuid())
  menuId     String
  /// Denormalized tenant key so every content query can be scoped in one hop.
  businessId String
  key        String

  nameAr        String
  nameEn        String?
  descriptionAr String?
  descriptionEn String?

  imageMediaId String?
  sortOrder    Int     @default(0)
  isActive     Boolean @default(true)
  isFeatured   Boolean @default(false)

  /// Subcategory support (Menu Studio §11). One level only: a category may
  /// have children, a child may not. Deeper nesting reads as a site map, not a
  /// menu, and no restaurant menu in the spec's examples needs it.
  parentId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu     Menu           @relation(fields: [menuId], references: [id], onDelete: Cascade)
  business Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  image    Media?         @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  parent   MenuCategory?  @relation("CategoryChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children MenuCategory[] @relation("CategoryChildren")
  items    MenuItem[]

  @@unique([menuId, key])
  @@index([businessId])
  @@index([menuId, sortOrder])
  @@index([parentId, sortOrder])
  @@map("menu_categories")
}

model MenuItem {
  id         String @id @default(cuid())
  categoryId String
  businessId String

  /// Stable, business-scoped item code. Exported to and matched from Excel so
  /// bulk edits update rather than duplicate (master spec §66).
  itemCode String

  nameAr        String
  nameEn        String?
  descriptionAr String?
  descriptionEn String?

  /// Integer minor units (e.g. halalas). Money is never a float.
  priceMinor Int?
  currency   String @default("SAR")

  /// Optional and only ever business-supplied. Never inferred (§37).
  ///
  /// The wider set below exists because Saudi menu regulation asks for more
  /// than calories, and because a field the business has not filled in must be
  /// distinguishable from one whose true value is zero. Every one is nullable
  /// for that reason: absent is absent, never 0 (§105; GOALS I9).
  calories      Int?
  /// Milligrams. Named in SFDA guidance alongside calories.
  caffeineMg    Int?
  sodiumMg      Int?
  /// Grams, to one decimal, stored as tenths so no float reaches the database.
  proteinDeci   Int?
  carbsDeci     Int?
  fatDeci       Int?
  fibreDeci     Int?
  sugarDeci     Int?
  /// Set by the business when it wants the high-salt notice shown.
  highSalt      Boolean @default(false)
  /// Free text the business supplies, e.g. a walking-equivalent statement.
  /// Never computed by the platform: a calorie-burn figure depends on the
  /// person, and inventing one would be a health claim (§05, §105).
  activityNoteAr String?
  activityNoteEn String?
  servingSizeAr String?
  servingSizeEn String?
  ingredientsAr String?
  ingredientsEn String?
  /// Declared allergens only; no medical claims are derived (§38).
  allergens     String[] @default([])
  tags          String[] @default([])

  /// Food cost in the same minor units as `priceMinor`. Optional, and only
  /// ever entered by the business: margin is computed from it and shown only
  /// when it exists. An absent cost is absent, never zero (GOALS I9, §39).
  costMinor Int?

  imageMediaId String?
  availability ItemAvailability @default(AVAILABLE)
  isFeatured   Boolean          @default(false)
  sortOrder    Int              @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category  MenuCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  business  Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  image     Media?                  @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  gallery   MenuItemImage[]
  overrides BranchItemOverride[]
  modifiers MenuItemModifierGroup[]

  @@unique([businessId, itemCode])
  @@index([categoryId, sortOrder])
  @@index([businessId, availability])
  @@map("menu_items")
}

model MenuItemImage {
  id        String @id @default(cuid())
  itemId    String
  mediaId   String
  sortOrder Int    @default(0)

  item  MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  media Media    @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([itemId, mediaId])
  @@index([itemId, sortOrder])
  @@map("menu_item_images")
}

/// Branch-level deviation from the shared menu (master spec §86). Absent row
/// means the branch serves the business-level values.
model BranchItemOverride {
  id       String @id @default(cuid())
  branchId String
  itemId   String

  priceMinor   Int?
  availability ItemAvailability?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  item   MenuItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([branchId, itemId])
  @@map("branch_item_overrides")
}

// ---------------------------------------------------------------------------
// PHASE 2 — permanent QR codes.
// ---------------------------------------------------------------------------

enum QrArtworkStyle {
  PLAIN
  WITH_LOGO
  WITH_NAME
  WITH_PROMPT
}

/// A saved QR configuration (master spec §12).
///
/// The row stores *artwork*, never the destination: the destination is derived
/// from the business's public id and the branch key every time it is rendered,
/// so it cannot drift from the printed code. Deleting this row does not
/// invalidate anything already printed — the code still resolves.
model QrCode {
  id         String  @id @default(cuid())
  businessId String
  /// Null for the business-level code.
  branchId   String?

  label      String
  artwork    QrArtworkStyle @default(PLAIN)
  foreground String         @default("#111111")
  background String         @default("#FFFFFF")
  sizePx     Int            @default(512)

  /// Last validation outcome, so admin can surface a warning without
  /// re-rendering (§13).
  lastValidatedAt DateTime?
  lastContrast    Float?
  lastOk          Boolean?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("qr_codes")
}

// ---------------------------------------------------------------------------
// PHASE 3 — audit trail.
// ---------------------------------------------------------------------------

/// Append-only record of consequential staff actions (master spec §123).
///
/// Deliberately not a foreign key to the entity: rows survive the deletion of
/// what they describe, which is the point of an audit trail.
model AuditLog {
  id String @id @default(cuid())

  /// Null for platform-level actions with no tenant.
  businessId String?
  userId     String?

  action   String
  entity   String
  entityId String?

  /// Before/after payloads for the fields that changed.
  metadata Json?

  createdAt DateTime @default(now())

  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// PHASE 4 — public files, PDF menus and external links.
// ---------------------------------------------------------------------------

enum PublicFileKind {
  /// A file the platform hosts and serves.
  FILE
  /// A link to a menu the business already hosts elsewhere (§51).
  LINK
}

/// A file or link the business has explicitly published (master spec §53, §107).
///
/// Not a general file store: only rows marked `isPublic` are reachable, and
/// the public route refuses anything else (§108).
model PublicFile {
  id         String @id @default(cuid())
  businessId String
  /// Stable, tenant-scoped key used in the public download path.
  key        String

  kind PublicFileKind @default(FILE)

  titleAr       String
  titleEn       String?
  descriptionAr String?
  descriptionEn String?

  /// Set for LINK rows.
  externalUrl String?

  /// Current version for FILE rows. Only this version is public (§50).
  currentVersionId String? @unique

  isPublic      Boolean @default(false)
  allowDownload Boolean @default(true)
  sortOrder     Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business       Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  versions       PublicFileVersion[] @relation("FileVersions")
  currentVersion PublicFileVersion?  @relation("FileCurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([businessId, key])
  @@index([businessId, isPublic, sortOrder])
  @@map("public_files")
}

/// An uploaded revision. Replacing a PDF adds a version and repoints the
/// pointer; the public URL and the QR are untouched (§48, §50).
model PublicFileVersion {
  id     String @id @default(cuid())
  fileId String

  version Int

  /// Provider-agnostic key; never a vendor URL.
  storageKey   String  @unique
  contentType  String
  sizeBytes    Int
  originalName String?
  checksum     String?

  uploadedById String?
  createdAt    DateTime @default(now())

  file       PublicFile  @relation("FileVersions", fields: [fileId], references: [id], onDelete: Cascade)
  currentOf  PublicFile? @relation("FileCurrentVersion")
  uploadedBy User?       @relation(fields: [uploadedById], references: [id], onDelete: SetNull)

  @@unique([fileId, version])
  @@map("public_file_versions")
}

// ---------------------------------------------------------------------------
// PHASE 5 — offers.
// ---------------------------------------------------------------------------

/// Where an offer appears on the profile (master spec §43).
enum OfferPlacement {
  HERO
  FEATURED
  BANNER
  SECTION
}

/// A scheduled promotion (master spec §41, §42).
///
/// Activation and expiry are computed from the stored window at read time
/// rather than by a job flipping a flag: a cron that fails must never leave an
/// expired offer on a customer's menu.
model Offer {
  id         String @id @default(cuid())
  businessId String
  key        String

  titleAr       String
  titleEn       String?
  descriptionAr String?
  descriptionEn String?

  imageMediaId String?

  /// Both in minor units, like every other price in the system.
  originalPriceMinor Int?
  offerPriceMinor    Int?
  /// Stored when the offer is expressed as a percentage rather than a price.
  discountPercent    Int?

  ctaLabelAr String?
  ctaLabelEn String?
  ctaUrl     String?

  /// Window bounds, stored as instants. `timezone` records the zone staff
  /// authored them in, so the admin UI can show what they typed.
  startsAt DateTime?
  endsAt   DateTime?
  timezone String    @default("Asia/Riyadh")

  placement  OfferPlacement @default(FEATURED)
  isActive   Boolean        @default(true)
  isFeatured Boolean        @default(false)
  sortOrder  Int            @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  image    Media?   @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)

  @@unique([businessId, key])
  @@index([businessId, isActive, startsAt, endsAt])
  @@map("offers")
}

// ---------------------------------------------------------------------------
// PHASE 6 — bulk import/export, price history and rollback.
// ---------------------------------------------------------------------------

enum ImportStatus {
  PENDING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ImportRowOutcome {
  CREATED
  UPDATED
  SKIPPED
  ERROR
}

/// One import run (master spec §75).
model ImportBatch {
  id         String  @id @default(cuid())
  businessId String
  userId     String?

  fileName String
  status   ImportStatus @default(PENDING)

  totalRows   Int @default(0)
  createdRows Int @default(0)
  updatedRows Int @default(0)
  skippedRows Int @default(0)
  errorRows   Int @default(0)

  /// The column mapping actually used, kept so a run can be explained later.
  mapping Json?

  createdAt    DateTime  @default(now())
  completedAt  DateTime?
  rolledBackAt DateTime?

  business Business    @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  rows     ImportRow[]

  @@index([businessId, createdAt])
  @@map("import_batches")
}

/// One spreadsheet row and what happened to it.
///
/// `beforeState` is what makes rollback possible: it holds the item's values
/// as they were *before* this row touched them (§76, §126).
model ImportRow {
  id      String @id @default(cuid())
  batchId String

  rowNumber Int
  itemCode  String?
  outcome   ImportRowOutcome

  /// Operator-facing problem description for ERROR rows (§63).
  errorColumn  String?
  errorValue   String?
  errorMessage String?

  beforeState Json?
  afterState  Json?

  batch ImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, outcome])
  @@map("import_rows")
}

/// Every price change, whatever made it (master spec §124).
model PriceHistory {
  id         String  @id @default(cuid())
  businessId String
  itemId     String?
  itemCode   String

  oldPriceMinor Int?
  newPriceMinor Int?
  currency      String

  changedById String?
  /// Set when the change came from an import, so a batch can be traced.
  batchId     String?

  createdAt DateTime @default(now())

  business  Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  changedBy User?    @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([businessId, createdAt])
  @@index([itemCode])
  @@map("price_history")
}

// ---------------------------------------------------------------------------
// PHASE 7 — analytics.
// ---------------------------------------------------------------------------

enum DeviceCategory {
  MOBILE
  TABLET
  DESKTOP
  UNKNOWN
}

/// A single recorded interaction (master spec §109, §110, §113).
///
/// Deliberately thin. There is no IP column, no user agent string and no
/// cookie identifier — only a salted daily hash that cannot be reversed and
/// stops being linkable at midnight.
model AnalyticsEvent {
  id         String  @id @default(cuid())
  businessId String
  branchKey  String?

  /// e.g. profile_view, qr_scan, item_view, download_click, contact_whatsapp.
  eventType String
  /// Item code, category key, file key — never an internal id.
  targetKey String?

  device      DeviceCategory @default(UNKNOWN)
  locale      String?
  /// Salted, rotating hash used only to count unique visitors within a day.
  visitorHash String?

  createdAt DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, createdAt])
  @@index([businessId, eventType, createdAt])
  @@map("analytics_events")
}

// ---------------------------------------------------------------------------
// PHASE 9 — programmatic API access.
// ---------------------------------------------------------------------------

/// A machine consumer of `/api/v1` — today, AI Marketing OS (master spec §130).
///
/// The token is stored only as a hash: a leaked database backup must not yield
/// working credentials. Scope is a business allowlist, so a key issued for one
/// client cannot read another's menus even if the id is known.
model ApiClient {
  id   String @id @default(cuid())
  name String

  /// Public, non-secret prefix shown in admin so a key can be identified.
  tokenPrefix String @unique
  tokenHash   String

  /// Empty means platform-wide (super-admin equivalent); otherwise an allowlist.
  businessIds String[] @default([])

  /// Identifier the consuming system knows this platform's client by (§130).
  marketingClientId String?

  scopes   String[] @default(["read"])
  isActive Boolean  @default(true)

  lastUsedAt DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@map("api_clients")
}

// ---------------------------------------------------------------------------
// Menu Studio (docs/MENU-STUDIO.md)
// ---------------------------------------------------------------------------

/// A reusable set of choices attached to items — "Size", "Milk", "Extras".
///
/// Groups belong to the business rather than to one item because a café's
/// "Milk" list is the same list on every drink, and duplicating it per item is
/// how menus drift out of sync.
model ModifierGroup {
  id         String @id @default(cuid())
  businessId String
  key        String

  nameAr String
  nameEn String?

  /// Selection bounds. `minSelect > 0` makes the group required.
  minSelect Int @default(0)
  maxSelect Int @default(1)

  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business                @relation(fields: [businessId], references: [id], onDelete: Cascade)
  options  ModifierOption[]
  items    MenuItemModifierGroup[]

  @@unique([businessId, key])
  @@index([businessId, sortOrder])
  @@map("modifier_groups")
}

/// One choice within a group. `priceDeltaMinor` is a difference, not a price:
/// "Large +3.00" survives a base price change, a stored absolute would not.
model ModifierOption {
  id         String @id @default(cuid())
  groupId    String
  businessId String
  key        String

  nameAr String
  nameEn String?

  priceDeltaMinor Int     @default(0)
  isDefault       Boolean @default(false)
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, key])
  @@index([groupId, sortOrder])
  @@map("modifier_options")
}

/// Which groups an item offers, in the order the item offers them.
model MenuItemModifierGroup {
  itemId     String
  groupId    String
  businessId String
  sortOrder  Int    @default(0)

  item  MenuItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  group ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([itemId, groupId])
  @@index([businessId])
  @@index([itemId, sortOrder])
  @@map("menu_item_modifier_groups")
}

/// The presentation settings a menu renders with.
///
/// Separate from `Menu` because it holds no menu *data*: swapping every field
/// here changes how the menu looks and nothing about what it says. That
/// separation is what makes theme switching safe (docs/MENU-STUDIO.md).
model MenuDesign {
  id     String @id @default(cuid())
  menuId String @unique

  businessId String

  /// Key into the in-code theme catalogue (src/menu-studio/themes).
  themeKey  String @default("modern-minimal")
  /// Layout system within the theme.
  layoutKey String @default("a")

  /// Typography roles. Null means "take the theme's default".
  fontHeading String?
  fontBody    String?
  fontPrice   String?
  fontAccent  String?

  /// Presentation overrides an operator set by hand, as theme-shaped values.
  /// Null everywhere means the theme is used exactly as authored.
  imageStyle   String?
  density      String?
  showPrices   Boolean @default(true)
  showImages   Boolean @default(true)
  showCalories Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menu     Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("menu_designs")
}

/// A brand identity derived from a logo, plus what the operator did with it.
///
/// Kept apart from `BrandTheme` — which is the palette actually in use — so the
/// measurement survives the editing. Every field records whether it came from
/// the image or from a person, because a colour nobody can trace is a colour
/// nobody trusts (GOALS I9).
model BrandPreset {
  id         String @id @default(cuid())
  businessId String
  key        String

  label String

  logoMediaId String?

  /// Extracted, in the order they dominate the logo. Hex, uppercase.
  extractedColors String[] @default([])
  /// Set by the analysis, then possibly overridden — see `manualOverrides`.
  colorPrimary    String
  colorSecondary  String
  colorAccent     String
  colorBackground String
  colorSurface    String
  colorText       String
  colorMuted      String
  colorBorder     String

  fontHeading String
  fontBody    String
  fontPrice   String
  fontAccent  String

  /// "light" | "dark" — which direction the logo pushes the page.
  tone String   @default("light")
  /// Descriptive words the analysis supports, e.g. ["warm", "premium"].
  mood String[] @default([])

  /// Theme this identity suggests. A suggestion, never applied silently.
  recommendedThemeKey String?

  /// Names of fields a person changed after extraction.
  manualOverrides String[] @default([])

  /// False when no logo was analysable and the values are platform defaults.
  fromLogo Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  logo     Media?   @relation("BrandPresetLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)

  @@unique([businessId, key])
  @@index([businessId])
  @@map("brand_presets")
}

// ---------------------------------------------------------------------------
// CLIENT REVIEW — preview links and approval without an account.
// ---------------------------------------------------------------------------

/// What the client did with a preview link (master spec §72, §139, §140).
enum ReviewState {
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

/// A shareable, expiring link that lets a client see their profile before it
/// is published, and approve it or ask for changes — without an account, a
/// password, or a dashboard (§71, §139).
///
/// The token is stored hashed, exactly as an API key is: a leaked database
/// row must not hand over working preview links. What is shown once, at
/// creation, is the only time the plaintext exists.
model PreviewLink {
  id         String @id @default(cuid())
  businessId String

  /// Short public handle, used in the URL beside the secret.
  key String @unique

  /// SHA-256 of the secret. The secret itself is never stored.
  tokenHash String

  /// Who the link was made for, so the record is meaningful later. Free text:
  /// a client is not a user of this system and has no account to reference.
  recipientNote String?

  expiresAt DateTime
  revokedAt DateTime?

  state       ReviewState @default(PENDING)
  respondedAt DateTime?
  /// The client's own words when asking for changes. Displayed to staff and
  /// never interpreted as an instruction by anything automatic.
  responseNote String?
  /// How the client identified themselves when responding. Optional and
  /// self-declared; never treated as authentication.
  respondedBy String?

  viewCount  Int       @default(0)
  lastViewed DateTime?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  createdBy      User?           @relation("PreviewLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  changeRequests ChangeRequest[]

  @@index([businessId, createdAt])
  @@map("preview_links")
}

/// A change the client asked for, recorded so a managed service can work
/// through them (§73, §140). Deliberately not a ticketing system: a note, who
/// it came from, and whether it is done.
model ChangeRequest {
  id         String  @id @default(cuid())
  businessId String
  /// Set when the request arrived through a preview link.
  previewLinkId String?

  body String

  isDone      Boolean   @default(false)
  completedAt DateTime?
  completedById String?

  createdAt DateTime @default(now())

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  previewLink PreviewLink? @relation(fields: [previewLinkId], references: [id], onDelete: SetNull)
  completedBy User?        @relation("ChangeRequestCompleter", fields: [completedById], references: [id], onDelete: SetNull)

  @@index([businessId, isDone, createdAt])
  @@map("change_requests")
}
